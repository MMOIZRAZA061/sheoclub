{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite",
            "bindings": [
                {
                    "type": "service",
                    "service": "node-backend",
                    "format": "url",
                    "env": "NODE_BACKEND_URL"
                }
            ]
        },
        "node-backend": {
            "root": "node-backend",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "node-backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}