generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("MONGODB_URI")
}

model User {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  password              String
  lastLogin             DateTime?          @map("last_login")
  isSuperuser           Boolean            @default(false) @map("is_superuser")
  username              String             @unique
  firstName             String             @default("") @map("first_name")
  lastName              String             @default("") @map("last_name")
  email                 String             @unique
  isStaff               Boolean            @default(false) @map("is_staff")
  isActive              Boolean            @default(true) @map("is_active")
  dateJoined            DateTime           @default(now()) @map("date_joined")
  address               String             @default("")
  city                  String             @default("")
  state                 String             @default("")
  postalCode            String             @default("") @map("postal_code")
  country               String             @default("")
  phone                 String             @default("")
  isSuspended           Boolean            @default(false) @map("is_suspended")
  newsletterSubscribed  Boolean            @default(false) @map("newsletter_subscribed")
  orders                Order[]
  reviews               Review[]
  wishlistItems         Wishlist[]
  notifications         UserNotification[]
  contactMessages       ContactMessage[]
  assignedCoupons       Coupon[]           @relation("AssignedCoupons")

  @@map("store_user")
}

model Brand {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  image       String   @default("")
  website     String   @default("")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  products    Product[]

  @@map("store_brand")
}

model Category {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String   @unique
  description        String   @default("")
  image              String?
  sortOrder          Int      @default(0) @map("sort_order")
  isActive           Boolean  @default(true) @map("is_active")
  discountPercentage Float    @default(0) @map("discount_percentage")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  products           Product[]
  @@map("store_category")
}

model Product {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String         @unique
  description       String         @default("")
  price             Float
  comparePrice      Float?       @map("compare_price")
  retailPrice       Float        @default(0) @map("retail_price")
  stock             Int            @default(0)
  categoryId        String?        @map("category_id") @db.ObjectId
  brandId           String?        @map("brand_id") @db.ObjectId
  image             String         @default("")
  imageAlt          String         @default("") @map("image_alt")
  status            Boolean        @default(true)
  isFeatured        Boolean        @default(false) @map("is_featured")
  hasVariants       Boolean        @default(false) @map("has_variants")
  freeDelivery      Boolean        @default(false) @map("free_delivery")
  minQuantity       Int            @default(1) @map("min_quantity")
  deliveryCharge    Float        @default(0) @map("delivery_charge")
  specifications    Json?
  tags              String         @default("")
  metaTitle         String         @default("") @map("meta_title")
  metaKeywords      String         @default("") @map("meta_keywords")
  metaDescription   String         @default("") @map("meta_description")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand             Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants          ProductVariant[]
  galleryImages     ProductImage[]
  reviews           Review[]
  wishlistItems     Wishlist[]
  orderItems        OrderItem[]
  banners           Banner[]

  @@map("store_product")
}

model ProductVariant {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  productId     String       @map("product_id") @db.ObjectId
  size          String       @default("")
  color         String       @default("")
  colorCode     String       @default("") @map("color_code")
  sku           String       @unique
  priceOverride Float?       @map("price_override")
  stock         Int          @default(0)
  image         String       @default("")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlists     Wishlist[]
  orderItems    OrderItem[]

  @@unique([productId, size, color])
  @@map("store_productvariant")
}

model ProductImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @map("product_id") @db.ObjectId
  image     String
  altText   String   @default("") @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("store_productimage")
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @map("product_id") @db.ObjectId
  userId     String   @map("user_id") @db.ObjectId
  rating     Int
  title      String   @default("")
  comment    String   @default("")
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications UserNotification[]

  @@unique([productId, userId])
  @@map("store_review")
}

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  productId String   @map("product_id") @db.ObjectId
  variantId String?  @map("variant_id") @db.ObjectId
  addedAt   DateTime @default(now()) @map("added_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@map("store_wishlist")
}

model Banner {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  image      String
  title      String   @default("")
  subtitle   String   @default("")
  linkUrl    String   @default("") @map("link_url")
  bannerType String   @default("hero") @map("banner_type")
  active     Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  productId  String?  @map("product_id") @db.ObjectId
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("store_banner")
}

model Coupon {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  code           String     @unique
  discountType   String     @default("percentage") @map("discount_type")
  discountValue  Float      @map("discount_value")
  minOrderAmount Float      @default(0) @map("min_order_amount")
  maxUses        Int        @default(0) @map("max_uses")
  usedCount      Int        @default(0) @map("used_count")
  isActive       Boolean    @default(true) @map("is_active")
  validFrom      DateTime   @default(now()) @map("valid_from")
  validTo        DateTime   @map("valid_to")
  assignedToId   String?    @map("assigned_to_id") @db.ObjectId
  isGift         Boolean    @default(false) @map("is_gift")
  autoGenerated  Boolean    @default(false) @map("auto_generated")
  batchId        String?    @map("batch_id")
  emailedAt      DateTime?  @map("emailed_at")
  description    String     @default("")
  createdAt      DateTime   @default(now()) @map("created_at")
  assignedTo     User?      @relation("AssignedCoupons", fields: [assignedToId], references: [id], onDelete: SetNull)
  orders         Order[]
  notifications  UserNotification[]

  @@map("store_coupon")
}

model DeliveryCharge {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  province        String   @default("Punjab")
  city            String   @unique
  charge          Float    @default(0)
  minOrderForFree Float    @default(0) @map("min_order_for_free")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tiers           DeliveryChargeTier[]

  @@map("store_deliverycharge")
}

model DeliveryChargeTier {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  deliveryChargeId String           @map("delivery_charge_id") @db.ObjectId
  minQuantity      Int              @map("min_quantity")
  maxQuantity      Int?             @map("max_quantity")
  charge           Float
  deliveryCharge   DeliveryCharge   @relation(fields: [deliveryChargeId], references: [id], onDelete: Cascade)

  @@map("store_deliverychargetier")
}

model Order {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  userId          String     @map("user_id") @db.ObjectId
  customerName    String     @default("") @map("customer_name")
  customerEmail   String     @default("") @map("customer_email")
  shippingAddress String     @default("") @map("shipping_address")
  city            String     @default("")
  phone           String     @default("")
  total           Float      @default(0)
  subtotal        Float      @default(0)
  discountAmount  Float      @default(0) @map("discount_amount")
  couponId        String?    @map("coupon_id") @db.ObjectId
  shippingCost    Float      @default(0) @map("shipping_cost")
  paidAmount      Float      @default(0) @map("paid_amount")
  dueAmount       Float      @default(0) @map("due_amount")
  paymentMethod   String     @default("") @map("payment_method")
  paymentStatus   String     @default("Unpaid") @map("payment_status")
  orderStatus     String     @default("Pending") @map("order_status")
  trackingNumber  String     @default("") @map("tracking_number")
  notes           String     @default("")
  paymentProof    String     @default("") @map("payment_proof")
  isPriority      Boolean    @default(false) @map("is_priority")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon          Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@map("store_order")
}

model OrderItem {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String       @map("order_id") @db.ObjectId
  productId String?      @map("product_id") @db.ObjectId
  variantId String?      @map("variant_id") @db.ObjectId
  quantity  Int
  price     Float
  total     Float      @default(0) @map("total")
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("store_orderitem")
}

model Setting {
  key   String @id @map("_id")
  value String @default("")

  @@map("store_setting")
}

model Announcement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  message     String
  isFlashSale Boolean  @default(false) @map("is_flash_sale")
  active      Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("store_announcement")
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @map("user_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  reply     String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("store_contactmessage")
}

model UserNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  subject   String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  couponId  String?  @map("coupon_id") @db.ObjectId
  reviewId  String?  @map("review_id") @db.ObjectId
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@map("store_usernotification")
}
